<mujoco model="arena_2wheel">
  <!-- =====================================================================
       MÔ HÌNH XE ROBOT 2 BÁNH VI SAI & SA BÀN THỬ NGHIỆM (MuJoCo MJCF)
       Đơn vị chuẩn quốc tế (SI): mét (m), kilôgam (kg), giây (s), độ (degree)
       Hệ trục của xe: +X hướng tới trước, +Y hướng sang trái, +Z hướng lên trên
       ===================================================================== -->

  <compiler angle="degree" coordinate="local"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <!-- Độ phân giải khung hình cho camera gắn trên xe (640x480) -->
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.75 0.75 0.75" specular="0.2 0.2 0.2"/>
  </visual>

  <asset>
    <!-- Họa tiết bàn cờ cho mặt sàn giúp dễ quan sát quãng đường di chuyển -->
    <texture name="grid_tex" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.86 0.88 0.90" rgb2="0.72 0.75 0.79"/>
    <material name="grid_mat" texture="grid_tex" texrepeat="8 8" reflectance="0.08"/>
    <texture name="sky_tex" type="skybox" builtin="gradient" width="256" height="256"
             rgb1="0.82 0.90 0.98" rgb2="0.96 0.98 1.0"/>
  </asset>

  <worldbody>
    <!-- Ánh sáng chiếu từ trên cao xuống sa bàn -->
    <light name="sun" pos="0 0 4.0" dir="0 0 -1" directional="true" castshadow="true"/>

    <!-- Camera toàn cảnh nhìn bao quát cả sân 4m x 4m -->
    <camera name="overview_cam" pos="-2.4 -2.4 2.6" xyaxes="0.707 -0.707 0 0.408 0.408 0.816" fovy="55"/>

    <!-- Điểm xuất phát mặc định của xe robot trên bản đồ cơ bản -->
    <site name="robot_spawn" pos="0 0 0" euler="0 0 0" size="0.01" rgba="0 0 0 0"/>

    <!-- Mặt sàn phẳng 4m x 4m (từ -2.0m đến +2.0m theo trục X và Y) -->
    <geom name="floor" type="plane" size="2.0 2.0 0.05" material="grid_mat"
          friction="0.9 0.005 0.0001"/>

    <!-- Bốn bức tường thấp bao quanh sa bàn để xe không rơi ra ngoài -->
    <geom name="wall_north" type="box" pos="0 2.025 0.125" size="2.05 0.025 0.125" rgba="0.35 0.38 0.42 1"/>
    <geom name="wall_south" type="box" pos="0 -2.025 0.125" size="2.05 0.025 0.125" rgba="0.35 0.38 0.42 1"/>
    <geom name="wall_east"  type="box" pos="2.025 0 0.125" size="0.025 2.00 0.125" rgba="0.35 0.38 0.42 1"/>
    <geom name="wall_west"  type="box" pos="-2.025 0 0.125" size="0.025 2.00 0.125" rgba="0.35 0.38 0.42 1"/>

    <!-- Các khối hộp chướng ngại vật màu sắc để thử nghiệm va chạm và né vật cản -->
    <body name="obs_red" pos="0.70 0.95 0.12">
      <geom name="obs_red_geom" type="box" size="0.12 0.12 0.12" rgba="0.90 0.25 0.20 1"/>
    </body>
    <body name="obs_blue" pos="0.85 -0.75 0.12">
      <geom name="obs_blue_geom" type="box" size="0.12 0.12 0.12" rgba="0.20 0.48 0.92 1"/>
    </body>
    <body name="obs_yellow" pos="-0.85 0.75 0.12">
      <geom name="obs_yellow_geom" type="cylinder" size="0.12 0.12" rgba="0.95 0.78 0.15 1"/>
    </body>

    <!-- Mục tiêu đích màu xanh lá sáng (mocap="true" cho phép kéo thả bằng chuột trên cửa sổ 3D) -->
    <body name="target" mocap="true" pos="1.4 0.0 0.12">
      <geom name="target_geom" type="cylinder" size="0.10 0.12" rgba="0.10 0.90 0.20 1"
            contype="1" conaffinity="1"/>
    </body>
  </worldbody>

  <include file="robot_2wheel.xml"/>
</mujoco>
