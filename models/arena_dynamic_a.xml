<mujoco model="arena_dynamic_a">
  <!-- =====================================================================
       VẬT CẢN DI ĐỘNG A (Sân mở 4m x 4m): 3 làn vật cản màu cắt ngang khác tốc độ & pha
       Xuất phát: (-1.65, 0.0), yaw=0° | Đích: (1.66, 0.0)
       ===================================================================== -->

  <compiler angle="degree" coordinate="local"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.75 0.75 0.75" specular="0.2 0.2 0.2"/>
  </visual>

  <asset>
    <texture name="grid_tex" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.86 0.88 0.90" rgb2="0.72 0.75 0.79"/>
    <material name="grid_mat" texture="grid_tex" texrepeat="8 8" reflectance="0.08"/>
    <texture name="sky_tex" type="skybox" builtin="gradient" width="256" height="256"
             rgb1="0.82 0.90 0.98" rgb2="0.96 0.98 1.0"/>
  </asset>

  <include file="robot_2wheel.xml"/>

  <worldbody>
    <light name="sun" pos="0 0 4.0" dir="0 0 -1" directional="true" castshadow="true"/>

    <camera name="overview_cam" pos="0 -3.3 4.2" xyaxes="1 0 0 0 0.78 0.62" fovy="52"/>

    <site name="robot_spawn" pos="-1.65 0.0 0" euler="0 0 0" size="0.01" rgba="0 0 0 0"/>

    <geom name="floor" type="plane" size="2.0 2.0 0.05" material="grid_mat"
          friction="0.9 0.005 0.0001"/>

    <!-- Tường bao 4 phía cao 0.28m -->
    <geom name="wall_north" type="box" pos="0 2.025 0.14" size="2.05 0.025 0.14" rgba="0.35 0.38 0.42 1"/>
    <geom name="wall_south" type="box" pos="0 -2.025 0.14" size="2.05 0.025 0.14" rgba="0.35 0.38 0.42 1"/>
    <geom name="wall_east"  type="box" pos="2.025 0 0.14" size="0.025 2.00 0.14" rgba="0.35 0.38 0.42 1"/>
    <geom name="wall_west"  type="box" pos="-2.025 0 0.14" size="0.025 2.00 0.14" rgba="0.35 0.38 0.42 1"/>

    <!-- 3 vật cản màu tuần tra cắt ngang theo trục Y -->
    <body name="obs_red" pos="-0.92 0.0 0.12">
      <joint name="obs_red_slide" type="slide" axis="0 1 0" range="-1.35 1.35"/>
      <geom name="obs_red_geom" type="cylinder" size="0.11 0.12" mass="8.0" rgba="0.90 0.25 0.20 1"/>
    </body>
    <body name="obs_blue" pos="0.0 0.0 0.12">
      <joint name="obs_blue_slide" type="slide" axis="0 1 0" range="-1.35 1.35"/>
      <geom name="obs_blue_geom" type="box" size="0.11 0.11 0.12" mass="8.0" rgba="0.20 0.48 0.92 1"/>
    </body>
    <body name="obs_yellow" pos="0.88 0.0 0.12">
      <joint name="obs_yellow_slide" type="slide" axis="0 1 0" range="-1.35 1.35"/>
      <geom name="obs_yellow_geom" type="cylinder" size="0.11 0.12" mass="8.0" rgba="0.95 0.78 0.15 1"/>
    </body>

    <body name="target" mocap="true" pos="1.66 0.0 0.12">
      <geom name="target_geom" type="cylinder" size="0.10 0.12" rgba="0.10 0.90 0.20 1"
            contype="1" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
